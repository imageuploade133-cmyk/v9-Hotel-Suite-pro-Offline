{
  "name": "nextn",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 9002",
    "genkit:dev": "genkit start -- tsx src/ai/dev.ts",
    "genkit:watch": "genkit start -- tsx --watch src/ai/dev.ts",
    "build": "node -e \"const fs=require('fs'); if(fs.existsSync('.next')) fs.rmSync('.next', {recursive:true, force:true});\" && NEXT_IGNORE_INCORRECT_NODE_VERSION=1 next build",
    "export": "npm run build",
    "start": "NEXT_IGNORE_INCORRECT_NODE_VERSION=1 next start",
    "start:master": "NEXT_IGNORE_INCORRECT_NODE_VERSION=1 next start -H 0.0.0.0 -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit"
  },
